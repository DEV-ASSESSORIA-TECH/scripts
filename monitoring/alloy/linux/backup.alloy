// Leitura dos backups (sempre instalada, sem modulo opcional).
// Nao ha coletor do Alloy: cada software de backup, ou um observador dele,
// grava /var/lib/alloy-textfile/backup/<service>__<backup_id>.prom conforme o
// contrato contracts/prometheus/backup.yml (repositorio grafana). Pasta vazia
// nao publica nenhuma serie backup_*. A pasta aceita escrita do grupo
// alloy-backup (criado pelo install.sh). O config.alloy fornece
// prometheus.remote_write.central.

prometheus.exporter.unix "backup" {
  set_collectors = ["textfile"]
  textfile {
    directory = "/var/lib/alloy-textfile/backup"
  }
}

discovery.relabel "backup" {
  targets = prometheus.exporter.unix.backup.targets
  rule {
    target_label = "job"
    replacement = "integrations/backup"
  }
  rule {
    target_label = "instance"
    replacement = constants.hostname
  }
  rule {
    target_label = "host"
    replacement = constants.hostname
  }
}

prometheus.scrape "backup" {
  targets = discovery.relabel.backup.output
  scrape_interval = "60s"
  forward_to = [prometheus.remote_write.central.receiver]
}
