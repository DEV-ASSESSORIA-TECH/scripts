// Modulo opcional: metricas e logs dos containers Docker.
// Acesso ao docker.sock concede privilegios equivalentes a root.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
  docker_only = true
  disable_root_cgroup_stats = true
  storage_duration = "5m"
  store_container_labels = false
  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
  ]
}

discovery.relabel "docker_metrics" {
  targets = prometheus.exporter.cadvisor.docker.targets
  rule {
    target_label = "job"
    replacement = "integrations/docker"
  }
  rule {
    target_label = "instance"
    replacement = constants.hostname
  }
  rule {
    target_label = "host"
    replacement = constants.hostname
  }
}

prometheus.scrape "docker" {
  targets = discovery.relabel.docker_metrics.output
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.central.receiver]
}

discovery.relabel "docker_logs" {
  targets = []
  // Label Docker opcional: com.assessoriatech.monitor.logs=false
  rule {
    source_labels = ["__meta_docker_container_label_com_assessoriatech_monitor_logs"]
    regex = "(false|off|disabled|no|0)"
    action = "drop"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "compose_service"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label = "stream"
  }
}

loki.process "docker" {
  forward_to = [loki.write.central.receiver]
  // Taxa maxima de linhas por container. Excedentes sao descartados.
  stage.limit {
    rate = 50
    burst = 200
    drop = true
    by_label_name = "container"
    max_distinct_labels = 5000
  }
}

loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.docker.containers.targets
  labels = { host = constants.hostname, job = "docker" }
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to = [loki.process.docker.receiver]
}
