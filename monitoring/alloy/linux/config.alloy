// Base Linux: host, systemd e journal. Modulos opcionais compartilham os destinos.

prometheus.exporter.unix "linux" {
  enable_collectors = ["systemd"]
  systemd {
    unit_include    = ".+\\.service"
    enable_restarts = true
  }
}

discovery.relabel "linux" {
  targets = prometheus.exporter.unix.linux.targets
  rule {
    target_label = "job"
    replacement = "integrations/unix"
  }
  rule {
    target_label = "instance"
    replacement = constants.hostname
  }
  rule {
    target_label = "host"
    replacement = constants.hostname
  }
}

prometheus.scrape "linux" {
  targets = discovery.relabel.linux.output
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  endpoint {
    url = "https://mon.assessoriatech.com/api/v1/write"
    oauth2 {
      client_id = "1T4SNZ8iDuvM18ZIB9fSc109ZZVglsXBtLxeU4ng"
      client_secret_file = "/etc/alloy/oauth-client-secret"
      token_url = "https://auth.assessoriatech.com/application/o/token/"
      scopes = ["profile"]
    }
  }
}

loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label = "unit"
  }
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label = "syslog_identifier"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label = "level"
  }
}

loki.source.journal "linux" {
  max_age = "1h"
  labels = { host = constants.hostname, job = "systemd-journal" }
  relabel_rules = loki.relabel.journal.rules
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "https://mon.assessoriatech.com/loki/api/v1/push"
    oauth2 {
      client_id = "1T4SNZ8iDuvM18ZIB9fSc109ZZVglsXBtLxeU4ng"
      client_secret_file = "/etc/alloy/oauth-client-secret"
      token_url = "https://auth.assessoriatech.com/application/o/token/"
      scopes = ["profile"]
    }
  }
}
